{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"/ABSOLUTE/PATH/TO/HumanUse/tools/hook.mjs\" --client claude --mode context", "timeout": 10 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"/ABSOLUTE/PATH/TO/HumanUse/tools/hook.mjs\" --client claude --mode context", "timeout": 10 }] }],
    "PostToolUse": [{ "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "node \"/ABSOLUTE/PATH/TO/HumanUse/tools/hook.mjs\" --client claude --mode notify", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"/ABSOLUTE/PATH/TO/HumanUse/tools/hook.mjs\" --client claude --mode stop --seconds 20", "timeout": 30 }] }]
  }
}
